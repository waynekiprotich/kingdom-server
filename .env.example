# The Kingdom Collection — backend environment (spec §2, §28)
# Copy to .env and fill in. Never commit .env.
#
# Generate each secret with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"

# Which config to load: development | testing | production
FLASK_ENV=development

# --- Required ---------------------------------------------------------------

# PostgreSQL connection. postgres:// and postgresql:// are both accepted and
# rewritten to the psycopg 3 driver.
DATABASE_URL=postgresql://kingdom:kingdom@localhost:5432/kingdom_collection

# Flask session/signing key. Minimum 32 bytes in production.
SECRET_KEY=

# JWT signing key for admin sessions. Must differ from SECRET_KEY.
JWT_SECRET_KEY=

# Comma-separated browser origins allowed to call the API. Scheme and host
# only — a trailing slash does not match, and the browser then blocks every
# request from the storefront.
#   local:      http://localhost:5173
#   production: https://kingdom-client.waynekip123.workers.dev
CORS_ORIGINS=http://localhost:5173

# How many proxies sit in front of the app. Locally there are none; on Render
# there is one. Rate limiting keys off the caller's address, and trusting more
# hops than really exist would let a caller forge it via X-Forwarded-For.
TRUSTED_PROXY_HOPS=0

# --- M-Pesa / Daraja (spec §9) ----------------------------------------------

# How the STK push is delivered.
#
#   simulator — the default in development. No Daraja account and no tunnel
#               needed: nothing is sent to a handset, but a synthetic callback
#               goes through the real handler a few seconds later, so the
#               whole flow works end to end. REFUSED IN PRODUCTION — the app
#               will not start with it.
#   daraja    — the real thing. Needs the consumer key and secret below.
MPESA_MODE=simulator

# From an app at https://developer.safaricom.co.ke. Secrets: never in a VITE_
# variable, never in the frontend. Only needed when MPESA_MODE=daraja.
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=

# Left blank, these fall back to Safaricom's published sandbox pair (shortcode
# 174379). Those are printed in Daraja's own documentation and are the same for
# everyone, so they are a default rather than a secret — but set your real till
# or paybill here before going live.
MPESA_SHORTCODE=
MPESA_PASSKEY=

# https://sandbox.safaricom.co.ke while testing;
# https://api.safaricom.co.ke once live.
MPESA_BASE_URL=https://sandbox.safaricom.co.ke

# CustomerPayBillOnline for a paybill, CustomerBuyGoodsOnline for a till.
MPESA_TRANSACTION_TYPE=CustomerPayBillOnline

# Must be a public HTTPS URL — Daraja cannot reach localhost. Use a tunnel
# (cloudflared, ngrok) in development, or stay on MPESA_MODE=simulator, which
# needs no callback URL at all.
MPESA_CALLBACK_URL=

# --- WhatsApp ---------------------------------------------------------------
# The shop's WhatsApp number, international format, digits only. Blank hides
# the WhatsApp option rather than showing a link that opens nothing.
# Not a payment method: it places the order and opens a chat, and payment is
# still M-Pesa.
WHATSAPP_NUMBER=

# --- Cloudinary (needed from the catalog phase, spec §17) -------------------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
