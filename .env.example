# The Kingdom Collection — backend environment (spec §2, §28)
# Copy to .env and fill in. Never commit .env.
#
# Generate each secret with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"

# Which config to load: development | testing | production
FLASK_ENV=development

# --- Required ---------------------------------------------------------------

# PostgreSQL connection. postgres:// and postgresql:// are both accepted and
# rewritten to the psycopg 3 driver.
DATABASE_URL=postgresql://kingdom:kingdom@localhost:5432/kingdom_collection

# Flask session/signing key. Minimum 32 bytes in production.
SECRET_KEY=

# JWT signing key for admin sessions. Must differ from SECRET_KEY.
JWT_SECRET_KEY=

# Comma-separated browser origins allowed to call the API. Scheme and host
# only — a trailing slash does not match, and the browser then blocks every
# request from the storefront.
#   local:      http://localhost:5173
#   production: https://kingdom-client.waynekip123.workers.dev
CORS_ORIGINS=http://localhost:5173

# How many proxies sit in front of the app. Locally there are none; on Render
# there is one. Rate limiting keys off the caller's address, and trusting more
# hops than really exist would let a caller forge it via X-Forwarded-For.
TRUSTED_PROXY_HOPS=0

# --- M-Pesa / Daraja (needed from the payments phase, spec §9) --------------
# Sandbox credentials during development. These are secrets: they must never
# appear in the frontend or in a VITE_ variable.
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_PASSKEY=
MPESA_SHORTCODE=
# Must be a public HTTPS URL — Daraja cannot reach localhost. Use a tunnel in
# development.
MPESA_CALLBACK_URL=

# --- Cloudinary (needed from the catalog phase, spec §17) -------------------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
